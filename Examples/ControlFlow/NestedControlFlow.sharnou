let index = 0;
let total = 0;
while (index < 4) {
    if (index == 1) {
        total = total + 10;
    } else {
        if (index >= 2) {
            total = total + 2;
        } else {
            total = total + 1;
        }
    }
    index = index + 1;
}
print(total);
if (total <= 15) {
    print("bounded");
} else {
    print("overflow");
}
