let minimum = -2147483647 - 1;
let maximum = 2147483647;
let equalValue = 7;

if (minimum < maximum) { print("lt"); } else { print("lt-false"); }
if (minimum > maximum) { print("gt-true"); } else { print("gt-false"); }
if (minimum <= minimum) { print("le"); } else { print("le-false"); }
if (maximum >= maximum) { print("ge"); } else { print("ge-false"); }
if (equalValue == 7) { print("eq"); } else { print("eq-false"); }
if (equalValue != 7) { print("ne-true"); } else { print("ne-false"); }

if (minimum < minimum) { print("lt-true-edge"); } else { print("lt-false-edge"); }
if (maximum > maximum) { print("gt-true-edge"); } else { print("gt-false-edge"); }
if (maximum <= minimum) { print("le-true-edge"); } else { print("le-false-edge"); }
if (minimum >= maximum) { print("ge-true-edge"); } else { print("ge-false-edge"); }
if (minimum == maximum) { print("eq-true-edge"); } else { print("eq-false-edge"); }
if (minimum != maximum) { print("ne-true-edge"); } else { print("ne-false-edge"); }
if (maximum > minimum) { print("gt-true-edge"); } else { print("gt-false-edge-final"); }
