fn sum_to(value) {
    let current = value;
    let total = 0;
    while (current > 0) {
        total = total + current;
        current = current - 1;
    }
    return total;
}

fn absolute(value) {
    let result = value;
    if (value < 0) {
        result = 0 - value;
    }
    return result;
}

print(sum_to(4));
print(absolute(-7));
