    "sequence": [
      "Create an execution-owned AppContainer profile and bind its genuine SID to a fresh crash-safe workspace.",
      "Configure an unnamed Job Object with KILL_ON_JOB_CLOSE, ACTIVE_PROCESS_LIMIT=1, and a bounded per-process memory limit before process creation.",
      "Create only the absolute System32 whoami.exe image suspended, with an explicit allowlisted environment and bInheritHandles=FALSE.",
      "Assign the suspended process to the configured Job Object and verify IsProcessInJob for that exact process/job pair.",
      "Verify TokenIsAppContainer=1, exact package SID, integrity RID no higher than Low, and zero TokenCapabilities.",
      "Permit ResumeThread only after workspace ACL, environment, suspended state, Job Object policy, assignment, membership and all token checks pass.",
      "Wait with a finite timeout, require exit code zero, reap the process, close handles, restore the exact workspace descriptor and delete only the profile owned by this fixture."
    ],
    "failClosedTests": [
      "Injected failure after process creation but before Job Object assignment.",
      "Invalid Job Object handle negative control for AssignProcessToJobObject.",
      "Actual child-token package SID mismatch.",
      "Final resume-gate negative control with one mandatory gate false."
    ],
    "limits": [
      "Test-only PowerShell/.NET in-memory P/Invoke; no production broker integration.",
      "No arbitrary command, executable, path, arguments, or model-generated input.",
      "No stdout/stderr capture or handle-list inheritance; those remain Phase 2B.5.",
      "Runtime evidence applies to Windows Server 2025 x64 only."
    ],
    "environment": {
      "status": "NOT VERIFIED FOR PRODUCTION",
