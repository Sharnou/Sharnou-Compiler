{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharnou.dev/schemas/devagent/gfx-campaign/v1.json",
  "title": "SharnouDevAgent Graphics Engineering Campaign v1",
  "description": "A dependency-aware, evidence-gated campaign manifest for generating Sharnou graphics compiler, analyzer, renderer and IDE milestones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaignId",
    "repository",
    "defaultBranch",
    "requestedMode",
    "activation",
    "executionPolicy",
    "generationRequirements",
    "milestones",
    "globalAcceptance"
  ],
  "properties": {
    "schemaVersion": { "const": "sharnou.devagent.gfx-campaign/1" },
    "campaignId": { "const": "sharnou.graphics-compiler" },
    "repository": { "const": "Sharnou/Sharnou-Compiler" },
    "defaultBranch": { "const": "Sharnou-Compiler" },
    "requestedMode": {
      "const": "automatic_generate_validate_and_open_draft_prs"
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "state", "blockingGates", "automaticMerge" ],
      "properties": {
        "state": {
          "enum": [
            "BLOCKED_UNTIL_DEVAGENT_PREREQUISITES_PASS",
            "READY_FOR_OWNER_ACTIVATION",
            "ACTIVE",
            "PAUSED",
            "STOPPED"
          ]
        },
        "blockingGates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "automaticMerge": { "const": false }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directDefaultBranchWrites",
        "automaticMerge",
        "automaticRelease",
        "draftPullRequestsOnly",
        "maxConcurrentMilestones",
        "maxRepairAttemptsPerMilestone",
        "maxFilesPerPatch",
        "maxChangedBytesPerPatch",
        "requireIsolatedWorktree",
        "requireBaselineSnapshot",
        "requireExactHeadWindowsEvidence",
        "requireIndependentPatchReview",
        "requireHumanAcceptanceBeforeDownstreamIntegration",
        "allowArbitraryCommands",
        "allowDownloadedExecutableExecution",
        "allowUnapprovedCompilerDependencies"
      ],
      "properties": {
        "directDefaultBranchWrites": { "const": false },
        "automaticMerge": { "const": false },
        "automaticRelease": { "const": false },
        "draftPullRequestsOnly": { "const": true },
        "maxConcurrentMilestones": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maxRepairAttemptsPerMilestone": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxFilesPerPatch": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxChangedBytesPerPatch": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "requireIsolatedWorktree": { "const": true },
        "requireBaselineSnapshot": { "const": true },
        "requireExactHeadWindowsEvidence": { "const": true },
        "requireIndependentPatchReview": { "const": true },
        "requireHumanAcceptanceBeforeDownstreamIntegration": { "const": true },
        "allowArbitraryCommands": { "const": false },
        "allowDownloadedExecutableExecution": { "const": false },
        "allowUnapprovedCompilerDependencies": { "const": false }
      }
    },
    "generationRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localInProcessInference",
        "typedWorkspacePatchTools",
        "qualifiedProcessBroker",
        "durableJournalAndRestartRecovery",
        "nativeGitHubRepositoryAdapter",
        "exactHeadEvidenceCollector",
        "primarySourceResearch",
        "optionalRemoteProviders"
      ],
      "properties": {
        "localInProcessInference": { "type": "boolean" },
        "typedWorkspacePatchTools": { "type": "boolean" },
        "qualifiedProcessBroker": { "type": "boolean" },
        "durableJournalAndRestartRecovery": { "type": "boolean" },
        "nativeGitHubRepositoryAdapter": { "type": "boolean" },
        "exactHeadEvidenceCollector": { "type": "boolean" },
        "primarySourceResearch": { "type": "boolean" },
        "optionalRemoteProviders": { "type": "boolean" }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/milestone" }
    },
    "globalAcceptance": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  },
  "$defs": {
    "milestoneId": {
      "type": "string",
      "pattern": "^GFX-(0\\.[1-8]|A\\.[1-3])$"
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "workstream",
        "status",
        "dependsOn",
        "agentRoles",
        "allowedPaths",
        "deliverables",
        "acceptanceGates",
        "hardStops",
        "requiresRealWindowsRuntimeEvidence",
        "requiresPhysicalGpuEvidence",
        "requiredOwnerDecisions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/milestoneId" },
        "title": { "type": "string", "minLength": 4, "maxLength": 160 },
        "workstream": { "enum": [ "shader_compiler", "asset_analysis", "ide", "gpu_runtime" ] },
        "status": {
          "enum": [
            "draft_pr_open",
            "draft_pr_open_windows_not_verified",
            "planned",
            "blocked_by_dependencies",
            "ready",
            "generating",
            "patch_ready",
            "testing",
            "windows_qualified",
            "owner_review",
            "accepted",
            "failed",
            "paused"
          ]
        },
        "existingPullRequest": { "type": "integer", "minimum": 1 },
        "existingPullRequestUrl": { "type": "string", "format": "uri" },
        "sourceBranch": { "type": "string", "maxLength": 120 },
        "sourceHeadSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/milestoneId" }
        },
        "agentRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 80 }
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "acceptanceGates": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "hardStops": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "requiresRealWindowsRuntimeEvidence": { "type": "boolean" },
        "requiresPhysicalGpuEvidence": { "type": "boolean" },
        "requiredOwnerDecisions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "draft_pr_open" } },
            "required": [ "status" ]
          },
          "then": {
            "required": [
              "existingPullRequest",
              "existingPullRequestUrl",
              "sourceBranch",
              "sourceHeadSha"
            ]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "draft_pr_open_windows_not_verified" } },
            "required": [ "status" ]
          },
          "then": {
            "required": [
              "existingPullRequest",
              "existingPullRequestUrl",
              "sourceBranch",
              "sourceHeadSha"
            ]
          }
        }
      ]
    }
  }
}
